#!/bin/sh
# ZTE E8820V2 hardware quirk: the MT7603E (2.4GHz) fails its PCIe ROM handshake
# on cold boot ("Timeout waiting for ROM code"). Re-binding the MT7621 PCIe host
# controller once recovers it. Backgrounded + `exit 0` so it can never block boot.
# The re-bind re-enumerates both cards into PCI domain 0001; the stale pre-rebind
# domain-0000 devices are removed to reclaim RAM on this 64MB board.
(
  i=0
  while [ $i -lt 20 ] && [ ! -d /sys/bus/platform/drivers/mt7621-pci/1e140000.pcie ]; do
    sleep 1; i=$((i+1))
  done
  if ! dmesg | grep -q "mt7603e.*firmware init done"; then
    echo 1e140000.pcie > /sys/bus/platform/drivers/mt7621-pci/unbind 2>/dev/null
    sleep 1
    echo 1e140000.pcie > /sys/bus/platform/drivers/mt7621-pci/bind 2>/dev/null
    sleep 4
    for d in 0000:01:00.0 0000:02:00.0; do
      [ -e /sys/bus/pci/devices/$d ] && echo 1 > /sys/bus/pci/devices/$d/remove 2>/dev/null
    done
    sleep 1
    wifi up 2>/dev/null
  fi
) &
exit 0
