#!/bin/sh
# ZTE E8820V2: Wi-Fi runs on the dedicated APs, not on this router.
# The 64MB RAM cannot reliably drive the MT76 radios alongside the full
# VLAN + firewall + dnsmasq load (OOM + mt76 "Hardware restart" loop), so both
# radios are left disabled in /etc/config/wireless and there is nothing to
# recover at boot.
exit 0
