# Guest network total bandwidth cap ~5 Mbps each direction (br-lan.30 = Guest VLAN).
# Included by fw4 into table inet fw4. Policer (drops excess); no shaping packages needed.
chain guest_qos {
    type filter hook forward priority 1; policy accept;
    oifname "br-lan.30" limit rate over 610 kbytes/second burst 128 kbytes drop comment "!fw4: guest 5Mbps down"
    iifname "br-lan.30" limit rate over 610 kbytes/second burst 128 kbytes drop comment "!fw4: guest 5Mbps up"
}
